# Copy to .env and fill in. The real .env is gitignored - never commit keys.

# VirusTotal API key (free tier is rate limited: 4 requests/min, 500/day)
VT_API_KEY=

# abuse.ch Auth-Key for MalwareBazaar (free: https://auth.abuse.ch/)
MB_API_KEY=

# Optional analysis tools (see README "Optional tools")
# CAPA_RULES_DIR=/path/to/capa-rules        # git clone https://github.com/mandiant/capa-rules
# CAPA_SIGS_DIR=/path/to/capa/sigs          # the sigs/ folder of https://github.com/mandiant/capa
# CLAMAV_DB_DIR=                            # only if your ClamAV database is not in the default location

# Optional overrides
# MALVEXIS_CACHE_DIR=~/.cache/malvexis
# MALVEXIS_RULES_DIR=rules
